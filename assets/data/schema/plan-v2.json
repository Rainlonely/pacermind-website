{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pacermind.app/spec/plan-json-v2.schema.json",
  "title": "PacerMind Plan JSON v2 Draft",
  "description": "Lean external schema for AI-generated PacerMind plans. Designed to stay compatible with Add Workout editing: warmup/cooldown, repeat blocks, work/rest segments, and time-distance switching.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "goal",
    "start_date",
    "end_date",
    "days"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0",
      "description": "Fixed schema version for the lean plan format."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    },
    "start_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Inclusive plan start date in local calendar date format."
    },
    "end_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Inclusive plan end date in local calendar date format."
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/day"
      }
    },
    "coachProgram": {
      "$ref": "#/definitions/coachProgram"
    }
  },
  "definitions": {
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "rest": {
          "type": "boolean",
          "description": "If true, workout and event must both be absent."
        },
        "workout": {
          "$ref": "#/definitions/workout"
        },
        "event": {
          "$ref": "#/definitions/event"
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "rest": {
                "const": true
              }
            },
            "required": [
              "rest"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "workout"
                  ]
                },
                {
                  "required": [
                    "event"
                  ]
                }
              ]
            }
          },
          "else": {
            "anyOf": [
              {
                "required": [
                  "workout"
                ]
              },
              {
                "required": [
                  "event"
                ]
              }
            ]
          }
        }
      ]
    },
    "workout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "blocks"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "easy",
            "aerobic",
            "steady",
            "long_run",
            "tempo",
            "threshold",
            "intervals",
            "race_like",
            "recovery"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "environment": {
          "type": "string",
          "enum": [
            "outdoor",
            "indoor"
          ]
        },
        "start_time": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "description": "Optional local clock time in HH:mm."
        },
        "warmup": {
          "$ref": "#/definitions/stage"
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/block"
          }
        },
        "cooldown": {
          "$ref": "#/definitions/stage"
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "value"
      ],
      "properties": {
        "metric": {
          "$ref": "#/definitions/metric"
        },
        "value": {
          "$ref": "#/definitions/value"
        },
        "target": {
          "$ref": "#/definitions/target"
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repeat",
        "segments"
      ],
      "properties": {
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "description": "How many times the segments inside this block repeat."
        },
        "label": {
          "type": "string",
          "maxLength": 80
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/segment"
          }
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "metric",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "work",
            "rest"
          ]
        },
        "metric": {
          "$ref": "#/definitions/metric"
        },
        "value": {
          "$ref": "#/definitions/value"
        },
        "target": {
          "$ref": "#/definitions/target"
        }
      }
    },
    "metric": {
      "type": "string",
      "enum": [
        "time",
        "distance"
      ],
      "description": "time uses minutes, distance uses kilometers."
    },
    "value": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Decimal minutes when metric=time, decimal kilometers when metric=distance."
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "pace": {
          "$ref": "#/definitions/pace"
        },
        "rpe": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "hr_zone": {
          "type": "string",
          "pattern": "^Z[1-5](?:-Z[1-5])?$"
        }
      }
    },
    "pace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "anyOf": [
        {
          "required": [
            "min"
          ]
        },
        {
          "required": [
            "max"
          ]
        }
      ],
      "description": "Minutes per kilometer. min is the faster bound, max is the slower bound."
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name",
        "distance"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "race"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "distance": {
          "type": "string",
          "enum": [
            "5k",
            "10k",
            "hm",
            "fm",
            "100k",
            "custom"
          ]
        },
        "importance": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "pb",
            "finish",
            "fun",
            "pacer"
          ]
        },
        "goal_time_sec": {
          "type": "integer",
          "minimum": 1
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "coachProgram": {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "revision",
        "intent",
        "startDate",
        "weekStart",
        "weeks"
      ],
      "properties": {
        "schemaVersion": {
          "const": "coach-program-1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "intent": {
          "enum": [
            "maintainRhythm",
            "buildConsistency",
            "easyAerobic",
            "enduranceDevelopment",
            "speedDevelopment",
            "recoveryBlock",
            "racePreparation"
          ]
        },
        "startDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "weekStart": {
          "enum": [
            "monday",
            "sunday"
          ]
        },
        "raceDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "weeks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 160,
          "items": {
            "type": "object",
            "required": [
              "id",
              "index",
              "blockIndex",
              "startDate",
              "endDate",
              "phase",
              "role",
              "focus",
              "reviewRequired"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "index": {
                "type": "integer",
                "minimum": 1
              },
              "blockIndex": {
                "type": "integer",
                "minimum": 1
              },
              "startDate": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "endDate": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "phase": {
                "enum": [
                  "base",
                  "build",
                  "peak",
                  "taper",
                  "race",
                  "free"
                ]
              },
              "role": {
                "enum": [
                  "establish",
                  "maintain",
                  "develop",
                  "consolidate",
                  "cutback",
                  "taper",
                  "race",
                  "return"
                ]
              },
              "focus": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "reviewRequired": {
                "type": "boolean"
              },
              "volumeRange": {
                "type": "object",
                "required": [
                  "min",
                  "max",
                  "unit"
                ],
                "properties": {
                  "min": {
                    "type": "number",
                    "minimum": 0
                  },
                  "max": {
                    "type": "number",
                    "minimum": 0
                  },
                  "unit": {
                    "enum": [
                      "km",
                      "min"
                    ]
                  }
                }
              },
              "qualityBudget": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "longRunFocus": {
                "type": "string",
                "maxLength": 300
              }
            }
          }
        },
        "review": {
          "type": "object",
          "required": [
            "asOfDate",
            "decision",
            "reason"
          ],
          "properties": {
            "asOfDate": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "decision": {
              "enum": [
                "keep",
                "reviewProgram"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        }
      }
    }
  }
}
