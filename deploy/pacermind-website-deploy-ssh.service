[Unit]
Description=PacerMind static website deployment-only SSH listener
After=network.target

[Service]
ExecStartPre=/usr/sbin/sshd -t -f /etc/ssh/pacermind-website-deploy.conf
ExecStart=/usr/sbin/sshd -D -e -f /etc/ssh/pacermind-website-deploy.conf
Restart=on-failure
RestartSec=5
RuntimeDirectory=pacermind-website-deploy
RuntimeDirectoryMode=0755
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/www/pacermind-website/auto /run/pacermind-website-deploy
TasksMax=32
MemoryMax=256M
CPUQuota=25%
IOWeight=10
Nice=10

[Install]
WantedBy=multi-user.target
